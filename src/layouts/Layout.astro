---
import "../styles/global.css";
import { site, href } from "../data/site";

interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const socialImage = new URL(href("/brand/social-card.png"), site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. A blue input token branches to two amber events that point to a blue output token.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fcfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={href("/favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={href("/favicon.svg?v=token-event")} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={href("/brand/apple-touch-icon.png?v=token-event")} />
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>
    <header class="mh-header">
      <div class="wrap bar">
        <a class="brand" href={href("/")}>
          <img src={href("/multihistory-mark.svg")} width="32" height="32" alt="" />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main navigation">
          {site.nav.map((item) => <a id={item.id} href={href(item.href)}>{item.label}</a>)}
        </nav>
        {site.github && <a class="github" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="mh-footer" id="about">
      <div class="wrap foot">
        <p>{site.disclaimer}</p>
        <div class="footer-links">
          <a href={href("/principles/")}>Founding principles <span aria-hidden="true">→</span></a>
          <a id="join" href={href("/contact/")}>Contact us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>
<style>
  .skip { position: absolute; z-index: 5; left: 1rem; top: .5rem; transform: translateY(-200%); background: var(--panel); padding: .5rem .85rem; }
  .skip:focus { transform: translateY(0); }
  .mh-header, .mh-footer { --wide: 1120px; }
  .mh-header { border-bottom: 1px solid var(--rule); }
  .bar { min-height: 70px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .5rem 1.25rem; padding-block: .6rem; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font: 600 1.19rem/1 var(--font-display); color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand img { width: 32px; height: 32px; }
  nav { display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: .25rem 1.35rem; font-weight: 650; font-size: .94rem; }
  nav a, .github { color: var(--ink); padding-block: .35rem; text-decoration: none; white-space: nowrap; }
  .github { font-weight: 650; font-size: .94rem; }
  nav a:hover, .github:hover, .footer-links a:hover { color: var(--green); text-decoration: underline; }
  .mh-footer { margin-top: 2.2rem; padding-block: 1.25rem; border-top: 1px solid var(--rule); background: var(--footer); }
  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem 1.75rem; flex-wrap: wrap; }
  .foot p { margin: 0; max-width: 82ch; font-size: .875rem; color: var(--muted); }
  .footer-links { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; }
  .footer-links a { font-weight: 650; font-size: .875rem; white-space: nowrap; color: var(--green); text-decoration: none; }
  @media (max-width: 640px) {
    .bar { grid-template-columns: 1fr auto; gap: .25rem .75rem; padding-block: .65rem .35rem; }
    .brand { font-size: 1.125rem; gap: .45rem; }
    .brand img { width: 24px; height: 24px; }
    nav { grid-area: 2 / 1 / 3 / -1; justify-content: space-between; gap: .2rem .38rem; font-size: .875rem; }
    .github { grid-area: 1 / 2; font-size: .875rem; }
    .mh-footer { margin-top: 1.5rem; padding-block: 1rem; }
  }
</style>
