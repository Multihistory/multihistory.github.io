---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site, href } from "../data/site";
import { home } from "../data/home";
import { researchAreas } from "../data/research";
import { link, person, photo } from "../lib/multihistory";

const featuredPeople = home.people.map(person).filter((member) => member !== undefined);
const introduction = `${home.introduction} ${home.projectName}.`;
---
<Layout description={`${introduction} ${home.purpose}`}>
  <div class="home wrap">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">{site.name}</h1>
        <p>{home.introduction}{" "}<a href={home.projectUrl}>{home.projectName}</a>.</p>
        <p class="hero-note">{home.purpose}</p>
        <div class="hero-actions">
          <a class="home-primary" href="#research">Explore the research <span aria-hidden="true">→</span></a>
          <a class="home-link" href={href("/statements/")}>Personal statements <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src={href("/multihistory-mark.svg")} alt="" width="218" height="232" />
      </div>
    </section>

    <p class="inspiration">This concept was inspired by <a href={home.arityUrl}>Arity Science</a>.</p>

    <section class="home-section" id="people" aria-labelledby="people-title">
      <div class="section-heading">
        <h2 id="people-title">People</h2>
        <p>Personal statements</p>
      </div>
      <ul class="people-grid">
        {featuredPeople.map((member) => {
          const portrait = photo(member.photo);
          const initials = member.name.split(" ").slice(0, 2).map((name) => name[0]).join("");
          return (
            <li>
              <a class="person" href={href(`/statements/#${member.slug}`)} aria-label={`Personal statement of ${member.name}`}>
                <span class="avatar" style={`--person-color:${member.color}`} aria-hidden="true">
                  {portrait ? <Image src={portrait} width={144} height={144} alt="" /> : <span class="initials">{initials}</span>}
                </span>
                <span class="person-name">{member.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="home-section" id="timeline" aria-labelledby="timeline-title">
      <div class="section-heading">
        <h2 id="timeline-title">Timeline</h2>
        <a class="home-link" href={href("/timeline/")}>Full timeline <span aria-hidden="true">→</span></a>
      </div>
      <ol class="milestones">
        {home.milestones.map((milestone) => (
          <li>
            <a href={link(milestone.href)}>
              <time datetime={milestone.date}>{milestone.date.slice(0, 4)}</time>
              <strong>{milestone.label}</strong>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-section" id="hyperseminar" aria-labelledby="seminar-title">
      <div class="section-heading">
        <h2 id="seminar-title">Hyperseminar</h2>
        <a class="home-link" href={home.youtube}>YouTube channel <span aria-hidden="true">↗</span></a>
      </div>
      <div class="video-grid" id="recordings">
        {home.seminars.map((seminar) => (
          <a class="video-card" href={`https://www.youtube.com/watch?v=${seminar.videoId}`}>
            <div class="video-cover">
              <Image src={seminar.cover} width={720} widths={[360, 720]} sizes="(max-width: 610px) 82vw, 360px" alt="" />
              <span class="play" aria-hidden="true"></span>
            </div>
            <div class="video-info">
              <p>{seminar.label}</p>
              <h3>{seminar.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="carousel-controls" id="recording-controls" hidden>
        <button type="button" aria-controls="recordings" aria-label="Previous recording">←</button>
        <button type="button" aria-controls="recordings" aria-label="Next recording">→</button>
      </div>
    </section>

    <section class="home-section" id="research" aria-labelledby="research-title">
      <div class="section-heading">
        <h2 id="research-title">Main research areas</h2>
        <a class="home-link" id="contributions" href={href("/topics/")}>Browse research topics <span aria-hidden="true">→</span></a>
      </div>
      <div class="research-grid">
        {researchAreas.map((area) => {
          const cover = home.guideCovers[area.slug];
          return (
            <a class="guide-card" href={href(`/guides/${area.slug}/`)}>
              {cover
                ? <Image class="guide-cover" src={cover} width={720} widths={[360, 720]} sizes="(max-width: 610px) 100vw, 360px" alt="" />
                : <div class="guide-cover guide-placeholder" aria-hidden="true"></div>}
              <div class="guide-copy">
                <ul class="tags" aria-label="Topics">
                  {area.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <h3>{area.title}</h3>
                <p>{area.question}</p>
                <span class="guide-action home-link">Open guide <span aria-hidden="true">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <p class="more-projects" id="other-research">
      <a class="home-link" id="projects" href={href("/projects/")}>More projects <span aria-hidden="true">→</span></a>
    </p>
  </div>
</Layout>

<script>
  const recordings = document.querySelector<HTMLElement>("#recordings");
  const controls = document.querySelector<HTMLElement>("#recording-controls");

  const first = recordings?.children[0];
  const second = recordings?.children[1];

  if (recordings && controls && first && second) {
    const [previous, next] = controls.querySelectorAll("button");
    const update = () => {
      const remaining = recordings.scrollWidth - recordings.clientWidth;
      controls.hidden = remaining <= 1;
      previous.disabled = recordings.scrollLeft <= 1;
      next.disabled = recordings.scrollLeft >= remaining - 1;
    };
    const scroll = (direction: number) => {
      const distance = second.getBoundingClientRect().left - first.getBoundingClientRect().left;
      const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
      recordings.scrollBy({ left: direction * distance, behavior });
    };

    previous.addEventListener("click", () => scroll(-1));
    next.addEventListener("click", () => scroll(1));
    recordings.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(recordings);
    update();
  }
</script>

<style>
  .home { --wide: 1120px; --home-green: var(--green); padding-top: 2.125rem; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--hero-edge);
    border-radius: 14px;
    background: linear-gradient(102deg, var(--hero-from) 25%, var(--hero-to));
  }
  .hero-copy { padding: clamp(1.6rem, 4.5vw, 3.5rem) 0 clamp(1.75rem, 4.5vw, 3.3rem) clamp(1.5rem, 4.5vw, 3.5rem); z-index: 1; }
  .hero h1 { font-size: clamp(2.4rem, 5.65vw, 4.75rem); letter-spacing: -.06em; line-height: 1; margin: 0 0 1.2rem; }
  .hero p { color: var(--ink); font-size: clamp(1.06rem, 1.64vw, 1.32rem); line-height: 1.4; max-width: 46ch; text-wrap: balance; margin: 0; }
  .hero p a { color: var(--home-green); }
  .hero .hero-note { color: var(--muted); margin-top: .6rem; max-width: 53ch; font-size: 1rem; }
  .hero-actions { display: flex; align-items: center; gap: .65rem 1.35rem; flex-wrap: wrap; margin-top: 1.45rem; }
  .home-primary {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-height: 44px;
    padding: .45rem .95rem;
    border-radius: 6px;
    background: var(--green-fill);
    color: white;
    text-decoration: none;
    font-weight: 650;
  }
  .home-primary:hover { background: var(--green-fill-hover); color: white; }
  .home-link { color: var(--home-green); font-size: .94rem; text-decoration: none; font-weight: 650; }
  .home-link:hover { color: var(--home-green); text-decoration: underline; }
  .hero-art {
    display: grid;
    place-items: center;
    background-image: radial-gradient(var(--hero-dots) .9px, transparent .9px);
    background-size: 16px 16px;
    mask-image: linear-gradient(90deg, transparent, black 26%);
  }
  .hero-art img { width: min(57%, 218px); }
  .home-section { margin-top: 2.125rem; border-top: 1px solid var(--rule); padding-top: 1.35rem; scroll-margin-top: 1rem; }
  .section-heading { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline; gap: .4rem 1.2rem; margin-bottom: .95rem; }
  .section-heading h2 { font-size: clamp(1.7rem, 2.75vw, 2.3rem); letter-spacing: -.04em; margin: 0; }
  .section-heading p { color: var(--muted); font-size: .94rem; margin: 0; }
  .people-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; gap: .5rem; }
  .person { display: flex; flex-direction: column; align-items: center; gap: .5rem; text-align: center; text-decoration: none; padding: .25rem; border-radius: 9px; color: var(--ink); font-weight: 650; font-size: .94rem; line-height: 1.15; }
  .person:hover { color: var(--home-green); }
  .person:hover .person-name { text-decoration: underline; }
  .avatar { width: 70px; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--person-color); padding: 3px; display: grid; place-items: center; flex-shrink: 0; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .initials { width: 100%; height: 100%; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--person-color) 13%, var(--panel)); font: 600 1.375rem/1 var(--font-display); }
  .person-name { max-width: 16ch; }
  .milestones { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; border-top: 1px solid var(--milestone-rule); margin: 1.4rem 0 0; }
  .milestones li { position: relative; padding-top: .65rem; padding-right: 1rem; }
  .milestones li::before { content: ""; position: absolute; width: 9px; height: 9px; border-radius: 50%; top: -5px; box-shadow: 0 0 0 3px var(--paper); background: var(--milestone-dot); }
  .milestones a { color: var(--ink); text-decoration: none; display: inline-grid; gap: .15rem; }
  .milestones a:hover { color: var(--home-green); text-decoration: underline; }
  .milestones time { color: var(--milestone-year); font-weight: 700; font-size: .875rem; }
  .milestones strong { font-size: .94rem; line-height: 1.28; font-weight: 650; }
  .video-grid { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3); gap: 1rem; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; }
  .video-grid::-webkit-scrollbar { display: none; }
  .video-card, .guide-card { border: 1px solid var(--rule); border-radius: 9px; background: var(--panel); color: var(--ink); text-decoration: none; }
  .video-card:hover, .guide-card:hover { border-color: var(--card-hover-edge); box-shadow: 0 2px 9px var(--card-hover-shadow); color: var(--ink); }
  .video-card { display: flex; flex-direction: column; overflow: hidden; scroll-snap-align: start; }
  .video-card:focus-visible { outline-offset: -3px; }
  .video-cover { position: relative; aspect-ratio: 16 / 9; background: #111525; }
  .video-cover img { width: 100%; height: 100%; object-fit: cover; }
  .play { position: absolute; right: 10px; bottom: 10px; width: 35px; height: 35px; display: grid; place-items: center; color: white; background: #141b26e0; border: 1px solid #ffffff99; border-radius: 50%; }
  .play::before { content: ""; border-left: 9px solid currentColor; border-top: 5px solid transparent; border-bottom: 5px solid transparent; margin-left: 2px; }
  .video-info { padding: .6rem .8rem .75rem; }
  .video-info p { color: var(--muted); font-size: .82rem; font-weight: 650; margin: 0 0 .15rem; }
  .video-info h3 { font: 650 1rem/1.25 var(--font-body); letter-spacing: 0; margin: 0; }
  .carousel-controls:not([hidden]) { display: flex; justify-content: flex-end; gap: .5rem; margin-top: .55rem; }
  .carousel-controls button { width: 44px; height: 44px; border: 1px solid var(--rule); background: var(--panel); border-radius: 50%; color: var(--ink); font: inherit; cursor: pointer; }
  .carousel-controls button:disabled { opacity: .4; cursor: default; }
  .research-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .guide-card { display: grid; grid-template-rows: auto 1fr; overflow: hidden; min-width: 0; }
  .guide-cover { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--cover); }
  .guide-placeholder { background: var(--placeholder); }
  .guide-copy { display: flex; flex-direction: column; padding: 1.05rem 1.15rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .25rem .375rem; margin: 0 0 .55rem; padding: 0; list-style: none; }
  .tags li { background: var(--tag); color: var(--tag-ink); font-size: .8rem; font-weight: 650; border: 1px solid var(--tag-edge); padding: 0 .5rem; border-radius: 20px; line-height: 1.65; }
  .guide-card h3 { font-size: clamp(1.4rem, 2.25vw, 1.85rem); letter-spacing: -.025em; margin: 0 0 .3rem; }
  .guide-card p { color: var(--muted); margin: 0 0 .9rem; line-height: 1.35; }
  .guide-action { margin-top: auto; padding-top: .7rem; border-top: 1px solid var(--rule); text-align: right; }
  .guide-card:hover .guide-action { text-decoration: underline; }
  .more-projects { margin: 1rem 0 0; }
  .inspiration { margin: .75rem 0 0; color: var(--muted); font-size: .9rem; }
  .inspiration a { color: var(--home-green); }

  @media (max-width: 840px) {
    .hero { grid-template-columns: minmax(0, 2fr) minmax(0, .8fr); }
    .hero-art img { width: 72%; }
    .person { font-size: .875rem; }
    .avatar { width: 58px; }
    .guide-copy { padding: .9rem; }
  }

  @media (max-width: 610px) {
    .home { padding-top: 1.05rem; }
    .hero { position: relative; display: block; }
    .hero-copy { position: relative; padding: 1.4rem 1.125rem; }
    .hero h1 { font-size: clamp(2.2rem, 9vw, 3.3rem); margin-bottom: .75rem; }
    .hero p { max-width: 34ch; }
    .hero .hero-note { max-width: 33ch; }
    .hero-art { position: absolute; inset: 0 0 0 48%; opacity: .19; }
    .hero-art img { display: none; }
    .hero-actions { gap: .65rem; margin-top: 1rem; font-size: .9rem; }
    .home-primary { padding-inline: .6rem; gap: .35rem; }
    .home-section { margin-top: 1.5rem; padding-top: .95rem; }
    .section-heading { margin-bottom: .75rem; }
    .section-heading .home-link, .section-heading p { font-size: .875rem; }
    .people-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem .15rem; }
    .milestones { grid-template-columns: 1fr 1fr; border: 0; gap: .9rem .5rem; margin-top: 1.1rem; }
    .milestones li { border-top: 1px solid var(--milestone-rule); padding-right: .5rem; }
    .video-grid { grid-auto-columns: 82%; gap: .625rem; }
    .research-grid { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
  }
</style>
