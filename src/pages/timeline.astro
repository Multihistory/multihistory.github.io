---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import { href } from "../data/site";
import { people, timeline } from "../lib/multihistory";

const active = people.filter((p) => timeline.some((e) => e.people.includes(p.slug)));
---
<Layout title="Detailed timeline" description="Detailed timeline of the Multi-History Science collaboration's involvement in the foundations of the Wolfram Physics Project, with public evidence for each entry.">
  <section class="wrap head">
    <p class="label"><a href={href("/")}>Multi-History Science</a> / Timeline</p>
    <h1>Detailed timeline</h1>
    <p class="intro">Each entry links to public evidence (papers, code, recordings, credits) and, where it draws on one, to a member's <a href={href("/statements/")}>personal statement</a>. Grey, hollow nodes are milestones of the Wolfram Physics Project itself, included for orientation.</p>
    <div class="filters" role="group" aria-label="Filter by person">
      <button type="button" class="chip" data-person="" aria-pressed="true">Everyone</button>
      {active.map((p) => (
        <button type="button" class="chip" data-person={p.slug} aria-pressed="false"><span class="dot" style={`--c:${p.color}`} />{p.name}</button>
      ))}
      <label class="ctx mono"><input type="checkbox" checked /> Project milestones</label>
    </div>
  </section>
  <section class="wrap body">
    <div class="cell sheet">
      <Timeline entries={timeline} detailed />
    </div>
    <p class="note muted">Corrections and further evidence are welcome. Entries marked with a statement link rely in part on that member's own account.</p>
  </section>
</Layout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".filters .chip")];
  const ctx = document.querySelector<HTMLInputElement>(".filters .ctx input")!;
  const items = [...document.querySelectorAll<HTMLLIElement>(".tl li")];
  const years = [...document.querySelectorAll<HTMLElement>(".tl .year")];
  let who = new URLSearchParams(location.search).get("person") ?? "";

  function apply() {
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.person === who)));
    items.forEach((li) => {
      const isCtx = li.dataset.context === "1";
      const show = isCtx ? ctx.checked : !who || li.dataset.people!.split(" ").includes(who);
      li.hidden = !show;
    });
    years.forEach((y) => { y.hidden = ![...y.querySelectorAll("li")].some((li) => !li.hidden); });
  }
  chips.forEach((c) => c.addEventListener("click", () => {
    who = c.dataset.person ?? "";
    const url = new URL(location.href);
    who ? url.searchParams.set("person", who) : url.searchParams.delete("person");
    history.replaceState(null, "", url);
    apply();
  }));
  ctx.addEventListener("change", apply);
  if (!chips.some((c) => c.dataset.person === who)) who = "";
  apply();
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem; }
  .label a { color: inherit; text-decoration: none; }
  h1 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem); margin: 0 0 .9rem; }
  .intro { max-width: var(--measure); color: var(--muted); font-size: 1.05rem; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin-top: 1.4rem; }
  .chip { display: inline-flex; align-items: center; gap: .4rem; padding: .32rem .75rem; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); font: inherit; font-size: .9rem; cursor: pointer; }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .ctx { display: inline-flex; align-items: center; gap: .4rem; margin-left: .5rem; color: var(--muted); font-size: .78rem; cursor: pointer; }
  .body { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .sheet { padding: clamp(1.1rem, 3vw, 2.2rem); }
  .note { font-size: .9rem; margin-top: 1rem; }
</style>
