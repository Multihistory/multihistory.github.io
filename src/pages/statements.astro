---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { href } from "../data/site";
import { people, photo, statements, hasStatement } from "../lib/multihistory";

const fmt = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const pending = people.filter((p) => !hasStatement(p.slug));
---
<Layout title="Personal statements" description="Personal statements by members of the Multi-History Science collaboration about their involvement in, and idea contributions to, the Wolfram Physics Project.">
  <section class="wrap head">
    <p class="label"><a href={href("/")}>Multi-History Science</a> / Statements</p>
    <h1>Personal statements</h1>
    <p class="intro">Each member's own account of their involvement and of the ideas they contributed, in their own words. Statements are combined with public evidence in the <a href={href("/timeline/")}>detailed timeline</a>.</p>
  </section>
  <section class="wrap list">
    {statements.map(({ slug, received, note, Content }) => {
      const p = people.find((x) => x.slug === slug)!;
      const img = photo(p.photo);
      return (
        <article class="cell statement" id={slug} style={`--c:${p.color}`}>
          <header>
            {img && <Image src={img} alt="" width={120} height={120} class="avatar" />}
            <div>
              <h2>{p.name}</h2>
              <p class="mono muted">Statement received {fmt(received)} · <a href={`${href("/timeline/")}?person=${slug}`}>timeline entries</a>{note && <> · {note}</>}</p>
            </div>
          </header>
          <details class="statement-copy">
            <summary>See more</summary>
            <div class="text"><Content /></div>
          </details>
        </article>
      );
    })}
    {pending.length > 0 && (
      <p class="pending muted">Statements forthcoming from {pending.map((p) => p.name).join(", ").replace(/, ([^,]*)$/, " and $1")}.</p>
    )}
  </section>
</Layout>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem; }
  .label a { color: inherit; text-decoration: none; }
  h1 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem); margin: 0 0 .9rem; }
  .intro { max-width: var(--measure); color: var(--muted); font-size: 1.05rem; margin: 0; }
  .list { display: grid; gap: 1.25rem; padding-bottom: clamp(3rem, 7vw, 5rem); }
  .statement { padding: clamp(1.3rem, 4vw, 2.6rem); border-top: 4px solid var(--c); scroll-margin-top: 80px; }
  .statement header { display: flex; align-items: center; gap: 1.1rem; margin-bottom: 1.4rem; }
  .avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 1px solid var(--rule); }
  .statement h2 { margin: 0 0 .15rem; font-size: 1.6rem; }
  .statement header p { margin: 0; font-size: .78rem; }
  .statement-copy summary { color: var(--link); cursor: pointer; font-family: var(--font-mono); font-size: .78rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .statement-copy summary::marker { color: var(--accent); }
  .statement-copy[open] summary { margin-bottom: 1.2rem; }
  .text { max-width: var(--measure); font-family: var(--font-display); font-size: 1.08rem; line-height: 1.7; }
  .text :global(p) { margin: 0 0 1.1em; }
  .text :global(ul) { padding-left: 1.2em; margin: 0 0 1.1em; }
  .text :global(li) { margin-bottom: .7em; }
  .text :global(strong) { font-weight: 600; }
  .pending { font-size: .95rem; }
</style>
